# Resend — ΜΟΝΟ για MyReels / myreels.gr
# Δημιούργησε αυτά στο Vercel → Project "myreels" → Settings → Environment Variables
# ΜΗΝ χρησιμοποιήσεις keys/domain από το cherriesonline.

RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=MyReels <onboarding@resend.dev>
LEAD_NOTIFY_EMAIL=contact@myreels.gr

# Ταχυδρομείο του admin. Το myreels.gr δείχνει σε Dreamhost.
MAILBOX_EMAIL=contact@myreels.gr
MAILBOX_PASSWORD=
MAILBOX_IMAP_HOST=imap.dreamhost.com
MAILBOX_IMAP_PORT=993
MAILBOX_SMTP_HOST=smtp.dreamhost.com
MAILBOX_SMTP_PORT=587

# Viva Smart Checkout — demo μέχρι να κλείσει δοκιμαστική πληρωμή.
# VIVA_DEMO=0 μόνο στον live λογαριασμό, μετά τη δοκιμή.
# Webhook URL: https://www.myreels.gr/api/viva
VIVA_DEMO=1
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_MERCHANT_ID=
VIVA_API_KEY=
VIVA_SOURCE_CODE=6980

# Ίδια στοιχεία με την είσοδο του admin, για να ανοίγει το ταχυδρομείο.
ADMIN_USER=
ADMIN_PASS=

# Google Sheet των επαφών. Το JSON είναι ολόκληρο το κλειδί του service account, σε μία γραμμή.
# Μοίρασε το Sheet σε αυτό το email ως Επεξεργαστή.
GOOGLE_SHEET_ID=1JLWqWL81F1u4t6ffRz7D8abSDxLgcAQHSkiI_j_Ir2M
GOOGLE_SERVICE_ACCOUNT=

# Σύνδεση YouTube + Drive από το admin, με τον λογαριασμό myreels.gr@gmail.com.
# OAuth client τύπου Web. Redirect URIs:
# https://myreels.gr/api/google-oauth
# https://www.myreels.gr/api/google-oauth
# http://localhost:3000/api/google-oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ACCOUNT=myreels.gr@gmail.com
