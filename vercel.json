{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/mail.js": { "includeFiles": "lib/*.mjs" },
    "api/lead.js": { "includeFiles": "lib/*.mjs" },
    "api/stay-board.js": { "includeFiles": "lib/*.mjs" },
    "api/stay-skip.js": { "includeFiles": "lib/*.mjs" },
    "api/stay-sequence.js": { "includeFiles": "lib/*.mjs" },
    "api/review.js": { "includeFiles": "lib/*.mjs" },
    "api/reel-page.js": { "includeFiles": "lib/*.mjs" },
    "api/reel-config.js": { "includeFiles": "lib/*.mjs" },
    "api/viva.js": { "includeFiles": "lib/*.mjs" },
    "api/youtube-title.js": { "includeFiles": "lib/*.mjs" }
  },
  "crons": [
    { "path": "/api/stay-sequence", "schedule": "0 8 * * *" }
  ],
  "rewrites": [
    { "source": "/api/google-link", "destination": "/api/youtube-title?part=link" },
    { "source": "/api/google-oauth", "destination": "/api/youtube-title?part=oauth" },
    { "source": "/api/checkout", "destination": "/api/viva?part=checkout" },
    { "source": "/api/orders", "destination": "/api/viva?part=orders" },
    { "source": "/api/stripe-webhook", "destination": "/api/viva?part=stripe" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/reel", "destination": "/api/reel-page" },
    { "source": "/en/luxurystayreels/:name", "destination": "/api/reel-page?name=:name&lang=en" },
    { "source": "/en/myairbnbreels/:name", "destination": "/api/reel-page?name=:name&lang=en" },
    { "source": "/en/upsell", "destination": "/upsell.html" },
    { "source": "/en/privacy", "destination": "/privacy-en.html" },
    { "source": "/en/privacy.html", "destination": "/privacy-en.html" },
    { "source": "/luxurystayreels/:name", "destination": "/api/reel-page?name=:name" },
    { "source": "/myairbnbreels/:name", "destination": "/api/reel-page?name=:name" }
  ]
}
